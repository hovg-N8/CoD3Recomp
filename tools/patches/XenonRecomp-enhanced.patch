+// Unsigned counterpart of simde_mm_vctsxs, for vctuxs / vcfpuxws128.
+// SSE has no float->uint32 conversion before AVX-512, so this saturates per
+// lane: NaN and anything at or below zero give 0, anything at or above
+// UINT32_MAX gives UINT32_MAX.
+inline simde__m128i simde_mm_vctuxs(simde__m128 src1)
+{
+    float f[4];
+    simde_mm_store_ps(f, src1);
+
+    uint32_t r[4];
+    for (int i = 0; i < 4; i++)
+    {
+        float x = f[i];
+        if (x != x)                       r[i] = 0;           // NaN
+        else if (x <= 0.0f)               r[i] = 0;
+        else if (x >= 4294967296.0f)      r[i] = UINT32_MAX;
+        else                              r[i] = (uint32_t)x;
+    }
+
+    simde__m128i dest;
+    memcpy(&dest, r, sizeof(r));
+    return dest;
+}
