+// A half float (1 sign, 5 exponent, 10 mantissa bits) widened to a float,
+// denormals, infinities and NaNs included: vupkd3d128's float16 types.
+inline float PPCHalfToFloat(uint16_t half)
+{
+    const uint32_t sign = uint32_t(half & 0x8000) << 16;
+    uint32_t exponent = (half >> 10) & 0x1F;
+    uint32_t mantissa = half & 0x3FF;
+    uint32_t bits;
+    if (exponent == 0)
+    {
+        if (mantissa == 0)
+        {
+            bits = sign;
+        }
+        else
+        {
+            // Denormal: normalise it, the float has the range.
+            exponent = 127 - 15 + 1;
+            while ((mantissa & 0x400) == 0)
+            {
+                mantissa <<= 1;
+                exponent--;
+            }
+            bits = sign | (exponent << 23) | ((mantissa & 0x3FF) << 13);
+        }
+    }
+    else if (exponent == 31)
+    {
+        bits = sign | 0x7F800000 | (mantissa << 13);
+    }
+    else
+    {
+        bits = sign | ((exponent + 127 - 15) << 23) | (mantissa << 13);
+    }
+    float result;
+    memcpy(&result, &bits, sizeof(result));
+    return result;
+}
+
+// A float narrowed to a half, rounded toward zero: vpkd3d128's float16
+// types. Too large a value is the largest half, a NaN stays a NaN.
+inline uint16_t PPCFloatToHalf(float value)
+{
+    uint32_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    const uint16_t sign = uint16_t((bits >> 16) & 0x8000);
+    const uint32_t exponent = (bits >> 23) & 0xFF;
+    const uint32_t mantissa = bits & 0x7FFFFF;
+    if (exponent == 0xFF)
+    {
+        return uint16_t(sign | 0x7C00 | (mantissa != 0 ? 0x200 | (mantissa >> 13) : 0));
+    }
+    const int32_t rebased = int32_t(exponent) - 127 + 15;
+    if (rebased >= 31) return uint16_t(sign | 0x7BFF);
+    if (rebased <= 0)
+    {
+        // A denormal of the half, or nothing.
+        if (rebased < -10) return sign;
+        return uint16_t(sign | ((mantissa | 0x800000) >> (14 - rebased)));
+    }
+    return uint16_t(sign | (uint32_t(rebased) << 10) | (mantissa >> 13));
+}
