# Game code. Never commit this: it is copyrighted, and it must come from the
# user's own disc dump.
CoD3RecompLib/private/

# Generated by XenonRecomp. 94 MB of machine-written C++, reproducible with
# scripts/recompile.ps1; the levels' code likewise, with scripts/recompile_level.ps1.
CoD3RecompLib/ppc/
CoD3RecompLib/levels/*/

# Build trees and logs.
build/
tools/build/
tools/build-scan/
tools/testobj/
*.log

# Installed game data and the remembered path to it.
CoD3Host/game/
game/
game.path

# Xenia's instruction tests and everything generated from them.
tools/xenia-tests/
tools/XenonRecomp/XenonTests/*.cpp

# Shader microcode captured from the running title: game data, not ours to ship.
shaders/

# A reference checkout, 225 MB, not used by the build.
tools/XenosRecomp/

# Frame dumps and captures.
*.bmp
shots/

# Python bytecode.
__pycache__/

# --- fork additions: never upload game data or generated game code ---
# Multiplayer's generated code (XenonRecomp output from the game's executable)
CoD3RecompLib/ppc_mp/
CoD3RecompLib/ppc*/
# Game files, disc images and archives
*.iso
*.xex
*.cod
*.wbk
*.bin
# Built programs and debug files
*.exe
*.pdb
*.dll
# Dumped and upscaled game textures, captures, logs
textures/
*.png.bak
CoD3MP.log
build-mp-log.txt
build-log.txt
recomp_*.log
# Port folders and friend packages
CoD3-PC-Port-*/
CoD3-for-friend/
*.zip

# Local diagnostics and packaged data
docs/build-logs/
*.dmp
*.7z
*.rar
*.obj
*.lib
# auto-build state (AUTO-BUILD.ps1)
build-request.txt
build-request.taken.txt
build-status.txt

# FFmpeg 8.0's headers, which the build needs for the game's sound
# (thirdparty/ffmpeg/include): supplied on each machine, not committed.
thirdparty/ffmpeg/

# Local build/test requests and source-release preparation
test-request.txt
build-request*.txt
build-status.txt

# Local tool state, backups and session settings (not source)
.claude/
tools/master-server/.wrangler/
CoD3Host/_backup_before_controller_fix/
CoD3Recomp/
